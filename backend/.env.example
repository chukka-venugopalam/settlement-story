# Settlement Story — Environment Configuration

# Gemini API key for LLM narration
# Get your key from: https://aistudio.google.com/app/apikeys
# Leave empty to use template-based narration (default, no API required)
GEMINI_API_KEY=your-key-here

# Narrator mode: "template" (default, no API needed) or "llm" (requires GEMINI_API_KEY)
NARRATOR_MODE=template
